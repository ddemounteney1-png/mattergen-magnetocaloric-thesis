# Materials Project API key
# Get yours at https://next-gen.materialsproject.org/api
MP_API_KEY=your-key-here

# Optional: ntfy.sh topic for pipeline progress notifications
# Leave blank to disable notifications
NTFY_TOPIC=

# Optional: where the long-running pipelines keep their working files.
# Defaults are under ./work/ (see code/project_paths.py for the full list).
# PIPELINE_WORK_DIR=/path/to/scratch
# MATTERGEN_DIR=/path/to/mattergen

# Needed only for the fine-tuning configs in configs/: the pre-trained base model
# PRETRAINED_MODEL_PATH=/path/to/mattergen_outputs/pretrain
